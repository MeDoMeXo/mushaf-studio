{
  "name": "quran-studio",
  "version": "0.1.0",
  "description": "Mushaf Studio — منصة قرآنية متكاملة: قارئ بالرسم العثماني، 38 قارئاً عالمياً، واستوديو تصميم وتصدير فيديوهات التلاوات",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "tsx --test lib/*.test.ts",
    "clean": "next clean",
    "db:push": "echo \"[db] skip: this project does not use Prisma\"",
    "db:generate": "echo \"[db] skip: this project does not use Prisma\"",
    "db:migrate": "echo \"[db] skip: this project does not use Prisma\"",
    "db:reset": "echo \"[db] skip: this project does not use Prisma\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.33",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript-eslint": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/visitor-keys": "8.73.0",
    "@typescript-eslint/type-utils": "8.73.0",
    "@typescript-eslint/types": "8.73.0",
    "@typescript-eslint/utils": "8.73.0",
    "@typescript-eslint/typescript-estree": "8.73.0",
    "@typescript-eslint/ast-spec": "8.73.0",
    "postcss": "^8.5.33",
    "postcss-selector-parser": "^6.1.5"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.11": true,
    "re2@1.27.2": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.32.0": true,
    "ffmpeg-static": true,
    "ffprobe-static": true
  },
  "trustedDependencies": [
    "protobufjs",
    "ffmpeg-static",
    "ffprobe-static"
  ]
}
